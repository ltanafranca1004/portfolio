---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CubeCanvas from '../components/CubeCanvas.astro';
import LensCard from '../components/LensCard.astro';
import Orbits from '../components/Orbits.astro';
import Pic from '../components/Pic.astro';
import PipelineArt from '../components/PipelineArt.astro';
import Route from '../components/Route.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Sky from '../components/Sky.astro';
import World from '../components/World.astro';
import frame from '../assets/frame.svg';
import { asset, content, destinations, otherProjects, person, projectUrl, PROFILE_URL } from '../lib/content';
import { absoluteUrl, metaDescription, OG_IMAGE } from '../lib/site';

const [unify, cubic, lens] = destinations;
if (!unify || !cubic || !lens) throw new Error('content.json needs three destinations');

// the small worlds are drawn at up to 1.25x on a 2x screen: three times their CSS size covers that
const webp = (path: string, width: number) => getImage({ src: asset(path), width, format: 'webp', quality: 86 });
const [turtleCard, turtleMascot, amenityMap, nutrifitBanner] = await Promise.all([
  webp('assets/mini-turtle-card.webp', 252),
  webp('assets/mini-turtle-mascot.webp', 120),
  webp('assets/d-amenity-tour.webp', 288),
  webp('assets/mini-nf-recipe-banner.webp', 228),
]);

const description = metaDescription(`${person.title} in ${person.location}. ${person.status}. ${person.bio}`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.title,
  url: absoluteUrl('/'),
  image: absoluteUrl(OG_IMAGE.path),
  alumniOf: { '@type': 'CollegeOrUniversity', name: content.education.school },
  sameAs: [person.github, person.linkedin],
};
---

<Base title={`${person.name} | ${person.title}`} description={description} jsonLd={jsonLd}>
  <script slot="head" is:inline>
    // The route draws in once per browser tab. Later visits to the map show it settled.
    try {
      if (sessionStorage.getItem('map-seen')) document.documentElement.classList.add('map-settled');
      else sessionStorage.setItem('map-seen', '1');
    } catch {
      /* no storage: the route simply draws in each time */
    }
    // Leaving the map: remember how far down it was scrolled and which world was opened, so
    // coming back lands on the same spot (the script at the end of this page puts it back).
    // "pagehide", never "unload": an unload handler keeps a page out of the back/forward cache.
    (() => {
      const save = (slug) => {
        if (document.prerendering) return; // a page rendered ahead of a click has no position yet
        try {
          const was = JSON.parse(sessionStorage.getItem('map-pos') || '{}');
          sessionStorage.setItem('map-pos', JSON.stringify({ y: Math.round(scrollY), slug: slug ?? was.slug ?? '' }));
        } catch {
          /* no storage: the browser's own scroll restoration is all there is */
        }
      };
      document.addEventListener(
        'click',
        (event) => {
          const link = event.target instanceof Element ? event.target.closest('.world-link, .mini-link') : null;
          if (link) save(link.dataset.slug ?? 'about');
        },
        true,
      );
      addEventListener('pagehide', () => save());
    })();
  </script>
  <div class="page map staged">
    <Sky />
    <div class="stage-wrap">
      <div class="stage">
        <Orbits class="only-desktop" />
        <Route />
        <svg class="phone-orbit phone-orbit-1 only-mobile" width="422" height="422" viewBox="-1 -1 422 422" fill="none" aria-hidden="true" data-keepout>
          <g class="orbit-lines"><circle cx="210" cy="210" r="210" stroke="rgb(232 194 122 / 0.3)" stroke-width="1"></circle></g>
        </svg>
        <svg class="phone-orbit phone-orbit-2 only-mobile" width="422" height="422" viewBox="-1 -1 422 422" fill="none" aria-hidden="true" data-keepout>
          <g class="orbit-lines"><circle cx="210" cy="210" r="209" stroke="rgb(232 194 122 / 0.4)" stroke-width="2" stroke-dasharray="0.1 6" stroke-linecap="round"></circle></g>
        </svg>

        <SiteHeader home />

        <main class="worlds">
          <World id="about" href={PROFILE_URL} title="About me" blurb={person.mapBlurb} blurbPhone={person.mapBlurbPhone} order={1}>
            <img slot="frame" class="ring-frame spin" src={frame.src} alt="" width="320" height="320" fetchpriority="high" />
            <Pic class="photo" src={asset(person.photo)} width={208} alt={person.name} loading="eager" />
          </World>

          <h2 class="sr-only" id="projects-heading">Projects</h2>
          <ul class="world-list" role="list" aria-labelledby="projects-heading">
            <li role="listitem">
              <div class="connector only-mobile" aria-hidden="true"><span></span><i></i><span></span></div>
              <World id="unify" href={projectUrl(unify.slug)} title={unify.name} blurb={unify.mapBlurb} blurbPhone={unify.mapBlurbPhone} chips={unify.chips} order={2} float="float2" level={3}>
                <img slot="frame" class="ring-frame spin" src={frame.src} alt="" width="320" height="320" />
                <Pic class="unify-hero" src={asset('assets/d-unify-hero.webp')} width={255} alt={unify.heroAlt} loading="eager" />
              </World>
            </li>
            <li role="listitem">
              <div class="connector only-mobile" aria-hidden="true"><span></span><i></i><span></span></div>
              <World id="cubic" href={projectUrl(cubic.slug)} title={cubic.name} blurb={cubic.mapBlurb} blurbPhone={cubic.mapBlurbPhone} chips={cubic.chips} order={3} float="float2" level={3}>
                <img slot="frame" class="ring-frame spin" src={frame.src} alt="" width="320" height="320" />
                <CubeCanvas class="world-cube" eager />
              </World>
            </li>
            <li role="listitem">
              <div class="connector only-mobile" aria-hidden="true"><span></span><i></i><span></span></div>
              <World id="lens" href={projectUrl(lens.slug)} title={lens.name} blurb={lens.mapBlurb} blurbPhone={lens.mapBlurbPhone} chips={lens.chips} order={4} level={3}>
                <img slot="frame" class="ring-frame spin" src={frame.src} alt="" width="320" height="320" />
                <LensCard />
              </World>
            </li>
          </ul>

          <div class="connector only-mobile" aria-hidden="true"><span></span><i></i><span></span></div>

          <section class="others in5" aria-labelledby="others-heading">
            <h2 id="others-heading" class="others-label">Other projects</h2>
            <ul class="minis">
              {
                otherProjects.map((project) => (
                  <li class="mini">
                    <div class="ring mini-ring float only-desktop" aria-hidden="true">
                      <img class="ring-frame spin" src={frame.src} alt="" width="320" height="320" />
                      {project.slug === 'turtle-trips' && (
                        <>
                          <div class="turtle-card"><img src={turtleCard.src} alt="" width="84" height="67" loading="lazy" decoding="async" data-eager-wide /></div>
                          <img class="turtle-mascot" src={turtleMascot.src} alt="" width="40" height="62" loading="lazy" decoding="async" data-eager-wide />
                        </>
                      )}
                      {project.slug === 'amenity-recommender' && (
                        <>
                          <div class="fold-map" style={`--map: url(${amenityMap.src})`}><div><i></i><i></i><i></i></div></div>
                          {[
                            [36, 26],
                            [62, 36],
                            [80, 22],
                          ].map(([left, top]) => (
                            <svg class="map-pin" width="12" height="16" viewBox="0 0 12 16" style={`left: ${left}px; top: ${top}px`}>
                              <path d="M6 16S0 9 0 6a6 6 0 0 1 12 0c0 3-6 10-6 10z" fill="#3b82f6" stroke="#fff" stroke-width="1" />
                              <circle cx="6" cy="6" r="2" fill="#fff" />
                            </svg>
                          ))}
                        </>
                      )}
                      {project.slug === 'pipeline-simulator' && <div class="mini-pipeline"><PipelineArt width={100} /></div>}
                      {project.slug === 'nutrifit' && (
                        <div class="recipe">
                          <div>
                            <img src={nutrifitBanner.src} alt="" width="76" height="16" loading="lazy" decoding="async" data-eager-wide />
                            <p><span></span><span></span><span></span></p>
                          </div>
                        </div>
                      )}
                    </div>
                    <i class="mini-dot only-mobile" aria-hidden="true"></i>
                    <h3 class="mini-name">
                      <a class="mini-link" href={projectUrl(project.slug)} data-event="project_open" data-slug={project.slug}>
                        <span class="only-desktop">{project.name}</span>
                        <span class="only-mobile">{'fullName' in project ? project.fullName : project.name}</span>
                      </a>
                    </h3>
                    <span class="mini-tag only-desktop">{project.tag}</span>
                  </li>
                ))
              }
            </ul>
          </section>
        </main>

        <p class="hint only-desktop">Select a destination</p>
        <p class="id-line only-desktop">ID: {person.email}</p>
      </div>
    </div>
  </div>
  <script is:inline>
    // Coming back to the map: put the page where it was left, before the first paint, so
    // there is no jump. This runs for the browser's Back and Forward buttons (the browser
    // restores the position itself as well; this only makes sure it is there in the first
    // frame) and for the header's back control when it had to load the map afresh
    // (components/SiteHeader.astro sets "map-return"). A reload or a new visit is left alone.
    // A map served from the back/forward cache never runs this: it is shown as it was left.
    (() => {
      const restore = () => {
        let pos = null;
        let asked = false;
        try {
          pos = JSON.parse(sessionStorage.getItem('map-pos') || 'null');
          asked = sessionStorage.getItem('map-return') !== null;
          sessionStorage.removeItem('map-return');
        } catch {
          return;
        }
        const type = performance.getEntriesByType('navigation')[0]?.type;
        if (!pos || !(asked || type === 'back_forward')) return;
        const go = () => {
          scrollTo({ left: 0, top: pos.y, behavior: 'instant' });
          // The world that was opened has to be in view. It is unless the layout changed in
          // between (a phone turned on its side), and then it is brought to the middle.
          const world = pos.slug ? document.querySelector(`.world-${pos.slug}, .mini:has([data-slug="${pos.slug}"])`) : null;
          const box = world?.getBoundingClientRect();
          if (box && (box.bottom < 0 || box.top > innerHeight)) world.scrollIntoView({ block: 'center', behavior: 'instant' });
        };
        go();
        // Safari lays this page out once in the fallback font even when the real one is cached,
        // which wraps two lines differently and leaves the page 44px shorter for a moment: a
        // position near the bottom is then cut short. So it is put back again just before the
        // first frame is painted, and once more when the fonts are in, unless the visitor has
        // started scrolling by then.
        let touched = false;
        for (const type of ['touchstart', 'wheel', 'keydown']) addEventListener(type, () => (touched = true), { once: true, passive: true });
        const again = () => touched || go();
        requestAnimationFrame(again);
        document.fonts?.ready.then(again, () => {});
      };
      // Chrome renders the map ahead of a click on the back control; it is shown later
      if (document.prerendering) document.addEventListener('prerenderingchange', restore, { once: true });
      else restore();
    })();
  </script>
</Base>

<style is:global>
  /* ===== phone and tablet: one centred column (design/Mobile.html) ===== */

  .map .stage {
    position: relative;
    --float-rise: -6px;
  }

  .phone-orbit {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }

  .phone-orbit-1 {
    left: -161px;
    top: 519px;
  }

  .phone-orbit-2 {
    right: -201px;
    top: 1219px;
  }

  .worlds {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 28px 24px 40px;
  }

  .world {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 420px;
    text-align: center;
  }

  .world .ring {
    --d: 170px;
  }

  .world-cubic .ring {
    --d: 190px;
  }

  .world-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 260px;
  }

  .divider span {
    flex: 1;
    height: 1px;
    background: rgb(var(--gold-rgb) / 0.5);
  }

  .divider i {
    width: 6px;
    height: 6px;
    border: 1px solid var(--gold);
    border-radius: 50%;
  }

  .world-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .world-name {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
  }

  /* the list itself draws nothing: its items are laid out as part of the map */
  .world-list,
  .world-list > li {
    display: contents;
  }

  .world-title .chip {
    padding: 3px 10px;
  }

  /* One link per world. The heading holds it, and it is stretched over the whole world: the
     ring, the picture or cube inside it, and the text. Nothing between the link and .world
     (or .mini) may be positioned, or the stretch stops there. The ring floats up to 8px
     above its box, so the link reaches a little higher too. */
  .world-link::after,
  .mini-link::after {
    content: '';
    position: absolute;
    inset: -10px 0 0;
    z-index: 1;
  }

  .world-link:focus-visible,
  .mini-link:focus-visible {
    outline: none;
  }

  .world:has(.world-link:focus-visible),
  .mini:has(.mini-link:focus-visible) {
    outline: 2px solid var(--gold);
    outline-offset: 6px;
    border-radius: 12px;
  }

  .world p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--body);
  }

  .photo {
    position: absolute;
    left: 10.5%;
    top: 10.5%;
    width: 79%;
    height: 79%;
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 2px rgb(var(--gold-rgb) / 0.85),
      0 0 36px rgb(var(--gold-rgb) / 0.35);
  }

  .unify-hero {
    position: absolute;
    left: 1.4%;
    top: 24.8%;
    width: 97.2%;
    height: auto;
  }

  .world-cube {
    left: 11.8%;
    top: 10%;
    width: 76.4%;
    height: 76.4%;
  }

  .connector {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .connector span {
    width: 1px;
    height: 44px;
    background: rgb(var(--gold-rgb) / 0.55);
  }

  .connector i {
    width: 9px;
    height: 9px;
    border: 1.5px solid var(--gold);
    border-radius: 50%;
  }

  .others {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    max-width: 420px;
    padding: 20px;
    border: 1px solid rgb(var(--gold-rgb) / 0.3);
  }

  .others-label {
    margin: 0 0 6px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .minis {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mini {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
  }

  .mini-dot {
    flex: none;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--gold);
    border-radius: 50%;
  }

  .mini-name {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
  }

  /* ===== desktop: the 1440 x 900 map, scaled as one piece (design/Main.html) ===== */

  @media (min-width: 1200px) {
    /* the stage itself (size, scale, centring) is in global.css */
    .map .stage {
      --float-rise: -8px;
    }

    .map .site-header {
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      z-index: 2;
    }

    .worlds {
      position: static;
      display: block;
      padding: 0;
    }

    .world {
      position: absolute;
      width: 300px;
      max-width: none;
      gap: 12px;
      transition: transform 0.35s ease;
    }

    .world:hover {
      transform: translateY(-6px);
    }

    .world:hover .world-link,
    .mini:hover .mini-link {
      color: var(--gold);
    }

    .world .ring {
      --d: 210px;
    }

    .world-cubic .ring {
      --d: 220px;
    }

    .world-about {
      left: 80px;
      top: 170px;
    }

    .world-unify {
      left: 410px;
      top: 92px;
    }

    .world-cubic {
      left: 720px;
      top: 350px;
    }

    .world-lens {
      left: 1050px;
      top: 140px;
    }

    .world-text {
      gap: 12px;
    }

    .divider {
      width: 300px;
    }

    .rule {
      width: 300px;
      height: 1px;
      background: rgb(var(--gold-rgb) / 0.5);
    }

    .world-title {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px 10px;
    }

    .world-name {
      font-size: 27px;
      letter-spacing: 0.03em;
    }

    .world-title .chip {
      padding: 3px 9px;
    }


    /* Worlds arrive one by one as the comet passes: the first visit in a tab only, and all
       of it done in one second (the last world starts at 0.5s and takes 0.5s). */
    .in1,
    .in2,
    .in3,
    .in4,
    .in5 {
      opacity: 0;
      animation: arrive 0.5s ease-out forwards;
    }

    .in1 {
      animation-delay: 0.1s;
    }

    .in2 {
      animation-delay: 0.2s;
    }

    .in3 {
      animation-delay: 0.3s;
    }

    .in4 {
      animation-delay: 0.4s;
    }

    .in5 {
      animation-delay: 0.5s;
    }

    .others {
      position: absolute;
      left: 64px;
      top: 638px;
      width: auto;
      max-width: none;
      padding: 0;
      border: 0;
    }

    .others-label {
      margin-bottom: 8px;
    }

    .minis {
      flex-direction: row;
      gap: 24px;
    }

    .mini {
      flex-direction: column;
      gap: 6px;
      width: 120px;
      min-height: 0;
      text-align: center;
      transition: transform 0.35s ease;
    }

    .mini:hover {
      transform: translateY(-6px);
    }

    .mini-ring {
      --d: 120px;
    }

    .mini-name {
      font-size: 14px;
      line-height: 1.2;
      white-space: nowrap;
    }

    .mini-tag {
      font-size: 12px;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .turtle-card {
      position: absolute;
      left: 26px;
      top: 30px;
      width: 84px;
      perspective: 400px;
    }

    .turtle-card img {
      display: block;
      width: 84px;
      height: auto;
      border-radius: 5px;
      box-shadow: 0 6px 14px rgb(0 0 0 / 0.5);
      transform: rotateY(-14deg) rotateZ(5deg);
    }

    .turtle-mascot {
      position: absolute;
      left: 4px;
      top: 50px;
      width: auto;
      height: 62px;
    }

    .fold-map {
      position: absolute;
      left: 12px;
      top: 34px;
      perspective: 300px;
    }

    .fold-map div {
      display: flex;
      transform: rotateX(28deg);
      box-shadow: 0 10px 16px rgb(0 0 0 / 0.45);
    }

    .fold-map i {
      width: 32px;
      height: 58px;
      background: var(--map) 0 0 / 96px 58px;
      transform: rotateY(22deg);
      transform-origin: right;
      box-shadow: inset 0 0 0 100px rgb(255 255 255 / 0.1);
    }

    .fold-map i:nth-child(2) {
      background-position: -32px 0;
      transform: rotateY(-22deg);
      transform-origin: center;
      box-shadow: inset 0 0 0 100px rgb(0 0 0 / 0.22);
    }

    .fold-map i:nth-child(3) {
      background-position: -64px 0;
      transform-origin: left;
    }

    .map-pin {
      position: absolute;
      filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.5));
    }

    .mini-pipeline {
      position: absolute;
      left: 10px;
      top: 28px;
    }

    .recipe {
      position: absolute;
      left: 16px;
      top: 30px;
      width: 88px;
      perspective: 400px;
    }

    .recipe > div {
      overflow: hidden;
      border-radius: 5px;
      background: #fff;
      box-shadow: 0 6px 14px rgb(0 0 0 / 0.5);
      transform: rotateY(-14deg) rotateZ(-4deg);
    }

    .recipe img {
      display: block;
      box-sizing: border-box;
      width: 88px;
      height: auto;
      padding: 6px 6px 2px;
    }

    .recipe p {
      display: flex;
      flex-direction: column;
      gap: 3px;
      margin: 0;
      padding: 3px 7px 7px;
    }

    .recipe p span {
      height: 5px;
      border-radius: 2px;
      background: #dfe7e2;
    }

    .recipe p span:nth-child(2) {
      width: 70%;
    }

    .recipe p span:nth-child(3) {
      align-self: flex-start;
      width: 26px;
      height: 7px;
      border-radius: 3px;
      background: #7fae95;
    }

    .hint {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 30px;
      margin: 0;
      text-align: center;
      font-size: 14px;
      letter-spacing: 0.14em;
      color: var(--text-muted);
      text-transform: uppercase;
      pointer-events: none;
    }

    .id-line {
      position: absolute;
      left: 104px;
      bottom: 30px;
      margin: 0;
      font-size: 12px;
      letter-spacing: 0.06em;
      color: rgb(217 220 235 / 0.7);
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      translate: 0 10px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* After the first visit in this tab the map is shown settled: no draw-in, no arrival. */
  .map-settled .in1,
  .map-settled .in2,
  .map-settled .in3,
  .map-settled .in4,
  .map-settled .in5 {
    animation: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .world,
    .mini {
      transition: none;
    }

    .in1,
    .in2,
    .in3,
    .in4,
    .in5 {
      animation: none;
      opacity: 1;
    }
  }
</style>
