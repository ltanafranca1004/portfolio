---
import Base from '../layouts/Base.astro';
import NewTab from '../components/NewTab.astro';
import Orbits from '../components/Orbits.astro';
import Pic from '../components/Pic.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Sky from '../components/Sky.astro';
import frame from '../assets/frame.svg';
import { asset, content, person, projectUrl, RESUME_URL } from '../lib/content';
import { metaDescription } from '../lib/site';

const { experience, skills, education } = content;

const TABS = [
  ['profile', 'Profile'],
  ['experience', 'Experience'],
  ['skills', 'Skills'],
  ['education', 'Education'],
] as const;

// The skills tree: four hubs around the centre, four skills fanned out from each.
const HUBS = [
  { x: 206, y: 165, side: -1 },
  { x: 506, y: 165, side: 1 },
  { x: 206, y: 395, side: -1 },
  { x: 506, y: 395, side: 1 },
];
const FAN = [
  { dx: 80, dy: -72 },
  { dx: 90, dy: -24 },
  { dx: 90, dy: 24 },
  { dx: 80, dy: 72 },
];
const tree = Object.entries(skills).map(([group, items], i) => {
  const hub = HUBS[i % HUBS.length]!;
  return {
    group,
    hub,
    // the group name sits above the upper clusters and below the lower ones
    labelX: hub.x + hub.side * 40,
    labelY: hub.y < 280 ? hub.y - 100 : hub.y + 116,
    leaves: items.map((name, j) => {
      const fan = FAN[j % FAN.length]!;
      return { name, x: hub.x + hub.side * fan.dx, y: hub.y + fan.dy };
    }),
  };
});
const treeLabel = `Skills. ${Object.entries(skills)
  .map(([group, items]) => `${group}: ${items.join(', ')}`)
  .join('. ')}.`;

// The highlights repeat facts that each project already states (its chips and facts). The
// build stops if one of them is no longer said there, so the two cannot drift apart.
const highlights = person.highlights.map((item) => {
  const project = [...content.destinations, ...content.otherProjects].find((p) => p.slug === item.project);
  if (!project) throw new Error(`content.json: highlight "${item.value}" names an unknown project "${item.project}"`);
  if (!JSON.stringify(project).toLowerCase().includes(item.value.toLowerCase())) throw new Error(`content.json: highlight "${item.value}" is not stated anywhere in the ${item.project} project`);
  return item;
});

const description = metaDescription(`${person.bio} ${person.status}.`);
---

<Base title={`About ${person.name} | Profile, experience and skills`} description={description} ogType="profile">
  <div class="page profile staged">
    <Sky />
    <Orbits class="orbits-backdrop" />

    <div class="stage-wrap">
      <div class="stage">
        <SiteHeader />

        <div class="profile-body">
          <aside class="profile-side">
            <div class="ring float profile-ring">
              <img class="ring-frame spin" src={frame.src} alt="" width="320" height="320" fetchpriority="high" />
              <Pic class="profile-photo" src={asset(person.photo)} width={328} alt={person.name} loading="eager" fetchpriority="high" />
            </div>
            <div class="identity">
              <h1>{person.name}</h1>
              <p class="identity-title">{person.title}</p>
              <p class="identity-where">{person.location} · <a href={`mailto:${person.email}`} data-event="email_click" data-placement="profile">{person.email}</a></p>
            </div>
          </aside>

          <div class="profile-main">
            <!--
              Four tabs at every width, one panel showing at a time. Every panel is always in
              the HTML. Before the script below has run, and without JavaScript, the address
              decides which one shows (#experience), so nothing changes when it takes over.
            -->
            <nav class="tabs" aria-label="Profile sections">
              {
                TABS.map(([id, label]) => (
                  <a href={`#${id}`} id={`tab-${id}`} data-tab={id}>
                    {label}
                  </a>
                ))
              }
            </nav>

            <main class="panels">
              <section class="panel" id="profile" data-panel>
                <h2>About me</h2>
                <div class="gold-rule" aria-hidden="true"></div>
                <p class="bio">{person.bio}</p>
                <dl class="quick-facts">
                  {
                    person.facts.map((fact) => (
                      <div>
                        <dt>{fact.label}</dt>
                        <dd>{fact.value}</dd>
                      </div>
                    ))
                  }
                </dl>
                <ul class="highlights" aria-label="Highlights">
                  {
                    highlights.map((item) => (
                      <li>
                        <a href={projectUrl(item.project)} data-event="project_open" data-slug={item.project} data-placement="profile_highlights">
                          <strong>{item.value}</strong>
                          <span>{item.label}</span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
                <div class="cta">
                  <div>
                    <h3>{person.status}.</h3>
                    <p>The fastest way to reach me is email.</p>
                  </div>
                  <a class="pill pill-solid" href={`mailto:${person.email}`} data-event="email_click" data-placement="profile_cta">Email me</a>
                  <a class="pill pill-ghost" href={RESUME_URL} target="_blank" rel="noopener noreferrer" data-event="resume_open" data-placement="profile_cta">Resume<NewTab /></a>
                </div>
              </section>

              <section class="panel" id="experience" data-panel>
                <h2>Where I work</h2>
                <div class="gold-rule" aria-hidden="true"></div>
                <div class="jobs">
                  {
                    experience.map((job, i) => (
                      <article class={i === 0 ? 'job job-lead' : 'job'}>
                        <div class="job-head">
                          <h3>
                            {job.role}, <span class="gold">{job.org}</span>
                          </h3>
                          <span class="job-when">{job.when}</span>
                        </div>
                        <p class="job-summary">{job.summary}</p>
                        {job.bullets.length > 0 && (
                          <ul class={job.bullets.length > 1 ? 'job-bullets two' : 'job-bullets'}>
                            {job.bullets.map((bullet) => (
                              <li>
                                <span class="gold" aria-hidden="true">◇</span>
                                <span>{bullet}</span>
                              </li>
                            ))}
                          </ul>
                        )}
                        {'awards' in job && job.awards && (
                          <div class="job-awards">
                            {job.awards.map((award) => <span class="chip award">{award}</span>)}
                            {'project' in job && job.project && (
                              <a class="see-project" href={projectUrl(job.project)} data-event="project_open" data-slug={job.project} data-placement="profile">
                                See the project <span aria-hidden="true">→</span>
                              </a>
                            )}
                          </div>
                        )}
                      </article>
                    ))
                  }
                </div>
                <a class="resume-link" href={RESUME_URL} target="_blank" rel="noopener noreferrer" data-event="resume_open" data-placement="profile">View full resume (PDF)<NewTab /></a>
              </section>

              <section class="panel" id="skills" data-panel>
                <h2>What I build with</h2>
                <div class="gold-rule" aria-hidden="true"></div>
                <svg class="skills-tree" viewBox="-24 36 760 488" role="img" aria-label={treeLabel}>
                  <circle cx="356" cy="280" r="150" fill="none" stroke="#E8C27A" stroke-opacity="0.15"></circle>
                  <circle cx="356" cy="280" r="250" fill="none" stroke="#E8C27A" stroke-opacity="0.08" stroke-dasharray="2 6"></circle>
                  {
                    tree.map(({ hub, leaves }) => (
                      <>
                        <path class="trace" d={`M356 280 L${hub.x} ${hub.y}`} stroke="#E8C27A" stroke-width="1.6" />
                        {leaves.map((leaf) => <path class="trace" d={`M${hub.x} ${hub.y} L${leaf.x} ${leaf.y}`} stroke="#E8C27A" stroke-opacity="0.6" stroke-width="1.1" />)}
                      </>
                    ))
                  }
                  {
                    tree.map(({ group, hub, labelX, labelY, leaves }) => (
                      <g>
                        <circle cx={hub.x} cy={hub.y} r="26" fill="#0b1430" stroke="#E8C27A" stroke-width="2" />
                        <circle cx={hub.x} cy={hub.y} r="8" fill="#E8C27A" />
                        <text class="hub-label" x={labelX} y={labelY} text-anchor="middle">{group.toUpperCase()}</text>
                        {leaves.map((leaf) => (
                          <>
                            <circle cx={leaf.x} cy={leaf.y} r="9" fill="#101a3a" stroke="#F3D99A" stroke-width="1.5" />
                            <circle cx={leaf.x} cy={leaf.y} r="3" fill="#F3D99A" />
                            <text class="leaf-label" x={leaf.x + hub.side * 18} y={leaf.y + 8} text-anchor={hub.side < 0 ? 'end' : 'start'}>{leaf.name}</text>
                          </>
                        ))}
                      </g>
                    ))
                  }
                  <circle cx="356" cy="280" r="40" fill="#0b1430" stroke="#E8C27A" stroke-width="2.5"></circle>
                  <circle cx="356" cy="280" r="48" fill="none" stroke="#E8C27A" stroke-opacity="0.4"></circle>
                  <text class="leaf-label" x="356" y="288" text-anchor="middle">{person.name.split(' ')[0]}</text>
                </svg>
              </section>

              <section class="panel" id="education" data-panel>
                <h2>Where I study</h2>
                <div class="gold-rule" aria-hidden="true"></div>
                <div class="school">
                  <h3>{education.school}</h3>
                  <p>{education.degree} · expected {education.expected}</p>
                </div>
                <h4>Relevant courses</h4>
                <ul class="courses">
                  {
                    education.courses.map(([code, title, flag]) => (
                      <li>
                        <span class="gold">{code}</span>
                        <span>
                          {title}
                          {flag === 'current' && <span class="muted"> (now)</span>}
                        </span>
                      </li>
                    ))
                  }
                </ul>
              </section>
            </main>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  // The four tabs, at every width.
  //
  // This is the ARIA tabs pattern: the row is a tablist with one Tab stop, the arrow keys (and
  // Home and End) move between tabs and show their panel, and each tab has its own address
  // (/profile/#experience) that opens it directly and that the Back button returns to.
  // On wide screens the panels cross-fade with a 16px shift in the direction of travel, 250ms.
  // On phones the panels have different heights and the page scrolls, so the old one simply
  // goes and the new one fades in. With reduced motion they swap.
  const WIDE = window.matchMedia('(min-width: 1200px)');
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');
  const body = document.querySelector<HTMLElement>('.profile-body');
  const list = document.querySelector<HTMLElement>('.tabs');
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('.tabs a[data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const tree = document.querySelector('.skills-tree');
  let current = 0;

  const fromHash = (): number => Math.max(0, tabs.findIndex((tab) => tab.hash === location.hash));

  /** Draw the skills tree the first time it is actually seen. */
  const drawTree = (): void => {
    if (tree?.classList.contains('is-waiting') && tree.checkVisibility({ visibilityProperty: true })) tree.classList.replace('is-waiting', 'is-drawing');
  };

  function show(index: number, animate: boolean): void {
    const from = current;
    current = index;
    tabs.forEach((tab, i) => {
      tab.setAttribute('aria-selected', String(i === index));
      tab.tabIndex = i === index ? 0 : -1;
    });
    for (const panel of panels) {
      for (const animation of panel.getAnimations()) animation.cancel();
      panel.classList.remove('is-leaving');
    }
    panels.forEach((panel, i) => panel.classList.toggle('is-active', i === index));
    // phones show the photo and name on the Profile tab only (see the styles below)
    if (body) body.dataset.tab = panels[index]?.id ?? '';
    const next = panels[index];
    const prev = panels[from];
    if (animate && next && prev && from !== index && !REDUCED.matches) {
      const shift = index > from ? 16 : -16;
      const timing = { duration: 250, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' };
      next.animate([{ opacity: 0, transform: `translateX(${shift}px)` }, { opacity: 1, transform: 'none' }], timing);
      if (WIDE.matches) {
        prev.classList.add('is-leaving');
        prev.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: `translateX(${-shift}px)` }], timing).finished.then(
          () => prev.classList.remove('is-leaving'),
          () => undefined,
        );
      }
    }
    drawTree();
    // the text on show has changed: the orbit lines keep clear of what is there now
    document.dispatchEvent(new Event('keepout:update'));
  }

  list?.setAttribute('role', 'tablist');
  tabs.forEach((tab, i) => {
    tab.setAttribute('role', 'tab');
    tab.setAttribute('aria-controls', panels[i]?.id ?? '');
    tab.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      // a real history entry, so Back returns to the tab before; no jump down the page
      if (location.hash !== tab.hash) history.pushState(null, '', tab.hash);
      show(i, true);
    });
    tab.addEventListener('keydown', (event) => {
      const to = { ArrowRight: (i + 1) % tabs.length, ArrowLeft: (i - 1 + tabs.length) % tabs.length, Home: 0, End: tabs.length - 1 }[event.key];
      const target = to === undefined ? undefined : tabs[to];
      if (to === undefined || !target) return;
      event.preventDefault();
      target.focus();
      history.replaceState(null, '', target.hash); // arrowing through tabs does not pile up history
      show(to, true);
    });
  });
  panels.forEach((panel, i) => {
    panel.setAttribute('role', 'tabpanel');
    panel.setAttribute('aria-labelledby', tabs[i]?.id ?? '');
  });
  // Back and Forward, or an address typed with a different #tab
  window.addEventListener('popstate', () => {
    if (fromHash() !== current) show(fromHash(), true);
  });

  if (tree && !REDUCED.matches) {
    tree.classList.add('is-waiting');
    new IntersectionObserver((entries) => entries.some((entry) => entry.isIntersecting) && drawTree(), { threshold: 0.3 }).observe(tree);
  }
  // the panel the address asked for is already the one showing: this only marks it
  show(fromHash(), false);
  document.documentElement.classList.add('tabbed');
</script>

<style is:global>
  /* ===== phones and tablets: header, the tab bar, then the one panel showing. The bar is
     part of the page (not pinned) and the panel scrolls with it. The photo and name belong
     to the Profile tab. ===== */

  .profile-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-sizing: border-box;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 20px 20px 48px;
  }

  .profile-side {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .profile-ring {
    --d: min(72vw, 300px);
    --float-rise: -10px;
    height: auto;
    aspect-ratio: 1;
  }

  .profile-photo {
    position: absolute;
    left: 10.95%;
    top: 10.95%;
    width: 78.1%;
    height: 78.1%;
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 2px rgb(var(--gold-rgb) / 0.85),
      0 0 50px rgb(var(--gold-rgb) / 0.35);
  }

  .identity {
    margin-top: 20px;
    text-align: center;
  }

  .identity h1 {
    margin: 0;
    font-size: 30px;
    font-weight: 500;
  }

  .identity-title {
    margin: 6px 0 0;
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .identity-where {
    margin: 4px 0 0;
    font-size: 15px;
    color: var(--text-muted);
  }

  .identity-where a {
    color: inherit;
  }

  .identity-where a:hover {
    color: var(--gold);
  }

  /* the right column's two parts become items of the page's own column, so the tab bar can
     sit first, straight under the header */
  .profile-main {
    display: contents;
  }

  .panels {
    min-width: 0;
  }

  .tabs {
    order: -1;
    display: flex;
    justify-content: space-between;
    gap: 8px;
    border-bottom: 1px solid rgb(var(--gold-rgb) / 0.25);
  }

  .tabs a {
    display: flex;
    flex: none;
    align-items: center;
    min-height: 48px;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    font-size: 16px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .tabs a:hover {
    color: var(--text);
  }

  .tabs a[aria-selected='true'] {
    color: var(--text);
    border-bottom-color: var(--gold);
  }

  .tabs a:focus-visible {
    outline-offset: -3px;
  }

  .panel {
    display: none;
    padding-top: 12px;
  }

  /* The script marks the panel to show. Before it runs, and without JavaScript, the address
     decides (#experience), and with no #tab the Profile panel shows. */
  .panel.is-active,
  .panel.is-leaving,
  html:not(.tabbed) .panel:target,
  html:not(.tabbed) .panels:not(:has(.panel:target)) #profile {
    display: block;
  }

  @media (max-width: 1199px) {
    .profile-body[data-tab]:not([data-tab='profile']) .profile-side,
    html:not(.tabbed) .profile-body:has(.panel:target:not(#profile)) .profile-side {
      display: none;
    }
  }

  .panel h2 {
    margin: 0 0 16px;
    font-size: 30px;
    font-weight: 500;
  }

  .panel .gold-rule {
    margin-bottom: 22px;
  }

  .bio {
    margin: 0 0 22px;
    padding-left: 16px;
    border-left: 2px solid var(--gold);
    font-size: 18px;
    line-height: 1.65;
    color: var(--body);
  }

  .quick-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 12px;
    margin: 0;
    border-top: 1px solid rgb(var(--gold-rgb) / 0.2);
    border-bottom: 1px solid rgb(var(--gold-rgb) / 0.2);
  }

  .quick-facts div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
  }

  .quick-facts dt {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .quick-facts dd {
    margin: 0;
    font-size: 16px;
  }

  /* Highlights: the same row as the facts, larger. A number or a short title with a small
     label under it, each one a link to its project. Two by two on phones. */
  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 12px;
    margin: 0;
    padding: 6px 0;
    border-bottom: 1px solid rgb(var(--gold-rgb) / 0.2);
    list-style: none;
  }

  .highlights a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 44px;
    padding: 12px 0;
  }

  .highlights strong {
    font-size: 28px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .highlights span {
    font-size: 14px;
    line-height: 1.35;
    color: var(--text-muted);
  }

  .highlights a:hover span {
    color: var(--text);
  }

  /* the summary's call to action: what I am looking for, Email me, Resume */
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: 26px;
  }

  .cta div {
    flex: 1 1 100%;
  }

  .cta h3 {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.25;
  }

  .cta p {
    margin: 4px 0 0;
    font-size: 15px;
    color: var(--text-muted);
  }

  .cta .pill {
    min-height: 48px;
    padding: 0 24px;
    border-radius: 24px;
    font-size: 16px;
  }

  .job {
    padding: 22px 0;
    border-bottom: 1px solid rgb(var(--gold-rgb) / 0.18);
  }

  .job:first-child {
    padding-top: 0;
  }

  .job:last-child {
    border-bottom: 0;
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 20px;
  }

  .job h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
  }

  .job-lead h3 {
    font-size: 23px;
  }

  .job-when {
    font-size: 14px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .job-summary {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--body);
  }

  .job-bullets {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px 28px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .job-bullets li {
    display: flex;
    gap: 10px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--body);
  }

  .job-awards {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
  }

  .chip.award {
    padding: 4px 11px;
    border-radius: 13px;
    font-weight: 400;
    letter-spacing: 0.1em;
  }

  .see-project {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-left: auto;
    font-size: 14px;
    color: var(--gold);
  }

  .see-project:hover,
  .resume-link:hover {
    color: var(--text);
  }

  .resume-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 6px;
    font-size: 16px;
    color: var(--gold);
  }

  .skills-tree {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    margin: 0 auto;
    overflow: visible;
    font-family: var(--font);
  }

  /* a dark edge keeps the branch lines from cutting through the labels */
  .skills-tree text {
    font-size: 24px;
    fill: var(--text);
    paint-order: stroke;
    stroke: var(--sky);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .skills-tree .hub-label {
    fill: var(--gold);
    letter-spacing: 2px;
  }

  /* the tree is drawn smaller on a phone, so its labels are set larger to stay readable */
  @media (max-width: 520px) {
    .skills-tree text {
      font-size: 30px;
    }
  }

  .skills-tree.is-waiting .trace {
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
  }

  .skills-tree.is-drawing .trace {
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: trace 1.4s cubic-bezier(0.65, 0, 0.35, 1) 0.2s forwards;
  }

  @keyframes trace {
    to {
      stroke-dashoffset: 0;
    }
  }

  .school {
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgb(var(--gold-rgb) / 0.2);
  }

  .school h3 {
    margin: 0;
    font-size: 21px;
    font-weight: 500;
  }

  .school p {
    margin: 0;
    font-size: 15px;
