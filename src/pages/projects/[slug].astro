---
import Base from '../../layouts/Base.astro';
import CubeCanvas from '../../components/CubeCanvas.astro';
import LensCard from '../../components/LensCard.astro';
import NewTab from '../../components/NewTab.astro';
import Orbits from '../../components/Orbits.astro';
import Pic from '../../components/Pic.astro';
import PipelineArt from '../../components/PipelineArt.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Sky from '../../components/Sky.astro';
import frame from '../../assets/frame.svg';
import { asset, person, projectUrl } from '../../lib/content';
import { highlight, neighbours, projects, type Project } from '../../lib/projects';
import { metaDescription } from '../../lib/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { prev, next } = neighbours(project);
const hero = project.hero ? asset(project.hero) : undefined;
// The tilted screenshots are 440px wide in the mockups, the widest one 460px.
const tiltWidth = hero && hero.width / hero.height > 2.05 ? 460 : 440;
const description = metaDescription(project.description);
const isGitHub = (url: string): boolean => new URL(url).hostname === 'github.com';
const track = (url: string) => (isGitHub(url) ? { 'data-event': 'github_click', 'data-slug': project.slug, 'data-placement': 'project' } : {});
---

<Base title={`${project.title} | ${person.name}`} description={description}>
  <div class="page project">
    <Sky />
    <Orbits class="orbits-backdrop" />

    <SiteHeader>
      <nav class="pager" aria-label="Projects">
        <a class="pager-link pager-prev" href={projectUrl(prev.slug)} rel="prev" data-pager="prev">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 6l-6 6 6 6"></path></svg>
          <span class="sr-only">Previous project: </span><span class="pager-name">{prev.name}</span>
        </a>
        <p class="label-pill"><span aria-hidden="true">{project.position}</span>{project.kind} {project.position} of {projects.length}</p>
        <a class="pager-link pager-next" href={projectUrl(next.slug)} rel="next" data-pager="next">
          <span class="sr-only">Next project: </span><span class="pager-name">{next.name}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 6l6 6-6 6"></path></svg>
        </a>
      </nav>
    </SiteHeader>

    <div class="project-body">
      <div class="hero float">
        <div class="hero-stage">
          <img class="ring-frame spin" src={frame.src} alt="" width="320" height="320" />
          {project.heroKind === 'image' && hero && <Pic class="hero-flat" src={hero} width={468} widths={[480, 720, 960]} sizes="(min-width: 1000px) 468px, 80vw" alt={project.heroAlt} loading="eager" fetchpriority="high" />}
          {project.heroKind === 'cube' && <CubeCanvas class="hero-cube" alt={project.heroAlt} eager />}
          {
            project.heroKind === 'lens' && (
              <div class="hero-lens" role="img" aria-label={project.heroAlt}>
                <LensCard hero />
              </div>
            )
          }
          {
            project.heroKind === 'tilted' && hero && (
              <div class="hero-tilt" style={`width: ${tiltWidth}px; aspect-ratio: ${hero.width} / ${hero.height}`}>
                <Pic src={hero} width={tiltWidth} widths={[460, 720, 920, 1100]} sizes="(min-width: 1000px) 460px, 80vw" alt={project.heroAlt} loading="eager" fetchpriority="high" />
              </div>
            )
          }
          {
            project.heroKind === 'pipeline' && (
              <div class="hero-pipeline">
                <PipelineArt width={330} label={project.heroAlt} />
              </div>
            )
          }
        </div>
      </div>

      <main class="project-main">
        <div class={`title-row ${project.title.length > 20 ? 'title-long' : ''}`}>
          <h1>{project.title}</h1>
          {project.chips.map((chip) => <span class="chip chip-lg">{chip}</span>)}
        </div>
        <div class="gold-rule" aria-hidden="true"></div>
        <p class="lede">{highlight(project.description, project.highlights).map((part) => (part.mark ? <span class="gold">{part.text}</span> : part.text))}</p>
        {project.awardsLine && <p class="awards">{project.awardsLine}</p>}

        <dl class="facts">
          {
            project.facts.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="actions">
          <a class="primary" href={project.primary[1]} target="_blank" rel="noopener noreferrer" {...track(project.primary[1])}>{project.primary[0]}<NewTab /></a>
          {
            project.links.map(([label, url]) => (
              <a class="text-link" href={url} target="_blank" rel="noopener noreferrer" {...track(url)}>
                {label}
                <NewTab />
              </a>
            ))
          }
        </div>

        <section class="problem">
          <h2>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"></path>
            </svg>
            {project.problemLabel}
          </h2>
          <p>{project.problem}</p>
        </section>

        <div class="shots">
          {
            project.shots.map((shot) => (
              <figure>
                <Pic class={shot.pixelated ? 'px' : undefined} src={asset(shot.src)} width={294} widths={[320, 640, 900]} sizes="(min-width: 1000px) 294px, 46vw" alt={shot.alt} crisp={shot.pixelated} />
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))
          }
        </div>
        <p class="stack">{project.stack.join(' · ')}</p>
      </main>
    </div>

    <footer class="project-foot">
      <a class="back" href="/">
        <span class="back-btn" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 6l-6 6 6 6M4 12h16"></path></svg>
        </span>
        <span class="back-text">
          <span class="back-note">{project.footnote}</span>
          <span class="back-label">Back to the map</span>
        </span>
      </a>
    </footer>
  </div>
</Base>

<script>
  // Left and Right arrow keys go to the previous and next project.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || event.defaultPrevented) return;
    const target = event.target as HTMLElement | null;
    // not while typing, and not while the contact panel is open
    if (target?.closest('input, textarea, select, [contenteditable]') || document.querySelector('dialog[open]')) return;
    const link = document.querySelector<HTMLAnchorElement>(`[data-pager="${event.key === 'ArrowLeft' ? 'prev' : 'next'}"]`);
    if (!link) return;
    event.preventDefault();
    link.click();
  });
</script>

<style is:global>
  .project {
    display: flex;
    flex-direction: column;
    --sky-position: 30% center;
  }

  /* ---- the pager: previous project, "3 of 7", next project ---- */

  .pager {
    order: 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'pill pill' 'prev next';
    align-items: center;
    gap: 10px 12px;
    margin-top: 18px;
    font-size: 15px;
  }

  .label-pill {
    grid-area: pill;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 7px 16px 7px 8px;
    border-radius: 24px;
    background: rgb(var(--sky-rgb) / 0.5);
    border: 1px solid rgb(var(--gold-rgb) / 0.35);
    white-space: nowrap;
  }

  .label-pill span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--gold);
    font-size: 12px;
  }

  .pager-link {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    min-height: 44px;
  }

  .pager-prev {
    grid-area: prev;
    justify-self: start;
  }

  .pager-next {
    grid-area: next;
    justify-self: end;
  }

  .pager-link svg {
    flex: none;
    color: var(--gold);
  }

  .pager-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    box-sizing: border-box;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 24px 20px 0;
  }

  /* The hero is drawn at the mockup's 520px and scaled to whatever room it has. */
  .hero {
    position: relative;
    flex: none;
    width: min(100%, 360px);
    aspect-ratio: 1;
    container-type: inline-size;
    --float-rise: -10px;
  }

  .hero-stage {
    position: absolute;
    left: 0;
    top: 0;
    width: 520px;
    height: 520px;
    transform-origin: 0 0;
    transform: scale(tan(atan2(100cqw, 520px)));
  }

  .hero-flat {
    position: absolute;
    left: 26px;
    top: 128px;
    width: 468px;
    height: auto;
  }

  .hero-cube {
    left: 71px;
    top: 66px;
    width: 378px;
    height: 378px;
  }

  .hero-lens {
    position: absolute;
    inset: 0;
  }

  .hero-lens .lens-card {
    transform: scale(2.35);
  }

  .hero-lens .lens-shot {
    border-radius: 4px;
    box-shadow: 0 8px 18px rgb(0 0 0 / 0.5);
  }

  .hero-tilt {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    perspective: 1200px;
  }

  .hero-tilt img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    object-fit: cover;
    box-shadow:
      0 0 0 1px rgb(var(--gold-rgb) / 0.5),
      0 24px 50px rgb(0 0 0 / 0.6);
    transform: rotateX(8deg) rotateY(-16deg) rotateZ(2deg);
  }

  .hero-pipeline {
    position: absolute;
    left: 95px;
    top: 160px;
  }

  .project-main {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    max-width: 600px;
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .title-row h1 {
    margin: 0;
    font-size: clamp(34px, 9vw, 46px);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .title-long h1 {
    font-size: clamp(28px, 7.4vw, 36px);
  }

  .chip-lg {
    padding: 5px 12px;
    border-radius: 14px;
    font-size: 12px;
  }

  .lede {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--body);
  }

  .awards {
    margin: -6px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--gold);
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 12px;
    margin: 0;
    border-top: 1px solid rgb(var(--gold-rgb) / 0.25);
    border-bottom: 1px solid rgb(var(--gold-rgb) / 0.25);
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
  }

  /* on a phone the role gets a row to itself, so a long one does not squeeze the others */
  .facts div:first-child {
    grid-column: 1 / -1;
    padding-bottom: 0;
  }

  .facts dt {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0;
    font-size: 16px;
  }

  /* The buttons sit under the role and facts, so they are on the first screen with the title. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 22px;
    font-size: 16px;
  }

  .text-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: rgb(var(--gold-rgb) / 0.5);
    text-underline-offset: 5px;
  }

  .primary {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 28px;
    background: var(--text);
    color: var(--ink);
    font-size: 19px;
    font-weight: 500;
  }

  .primary:hover {
    background: var(--gold);
    color: var(--ink);
  }

  .problem {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .problem h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 15px;
    font-weight: 400;
    color: var(--gold);
  }

  .problem p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--body);
  }

  .shots {
    display: flex;
    gap: 12px;
  }

  .shots figure {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    margin: 0;
  }

  .shots img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    aspect-ratio: 294 / 150;
    object-fit: cover;
    object-position: center top;
    border: 1px solid rgb(var(--gold-rgb) / 0.45);
    background: #fff;
  }

  .shots img.px {
    object-position: center;
    background: none;
  }

  .shots figcaption {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .stack {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.06em;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .project-foot {
    display: flex;
    box-sizing: border-box;
    width: 100%;
    max-width: 640px;
    margin: 32px auto 0;
    padding: 0 20px 36px;
  }

  @media (min-width: 640px) {
    .pager {
      flex-basis: 100%;
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas: 'prev pill next';
      gap: 0 18px;
      max-width: 620px;
      margin: 16px auto 0;
    }

    .project .site-header {
      flex-wrap: wrap;
    }

    .project-body {
      padding: 32px 40px 0;
    }

    .hero {
      width: min(100%, 420px);
    }

    .facts {
      grid-template-columns: minmax(33%, max-content) 1fr 1fr;
    }

    .facts div:first-child {
      grid-column: auto;
      padding-bottom: 12px;
    }

    .primary {
      width: auto;
      min-width: 300px;
    }

    .project-foot {
      padding: 0 40px 44px;
    }
  }

  /* ===== wide screens: hero left, text right (design/Detail*.html) ===== */

  @media (min-width: 1000px) {
    /* the pager joins the header row, between the name and the nav */
    .project .site-header {
      flex-wrap: nowrap;
    }

    .pager {
      order: 0;
      flex: 0 1 auto;
      min-width: 0;
      max-width: none;
      margin: 6px auto 0;
      gap: 0 14px;
    }

    .pager-name {
      max-width: 150px;
    }

    .project-body {
      display: grid;
      grid-template-columns: minmax(280px, 1fr) minmax(0, 600px);
      align-items: start;
      gap: 0 clamp(32px, 6.25vw, 90px);
      padding: 27px 80px 0 64px;
    }

    .hero {
      justify-self: end;
      width: min(100%, 520px);
      margin: 50px 0 0;
    }

    .project-foot {
      max-width: 1440px;
      margin-top: auto;
      padding: 16px 64px 44px;
    }
  }
</style>
