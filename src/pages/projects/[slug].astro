---
import Base from '../../layouts/Base.astro';
import CubeCanvas from '../../components/CubeCanvas.astro';
import LensCard from '../../components/LensCard.astro';
import NewTab from '../../components/NewTab.astro';
import Orbits from '../../components/Orbits.astro';
import Pic from '../../components/Pic.astro';
import PipelineArt from '../../components/PipelineArt.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Sky from '../../components/Sky.astro';
import frame from '../../assets/frame.svg';
import { asset, person, projectUrl } from '../../lib/content';
import { highlight, neighbours, projects, type Project } from '../../lib/projects';
import { metaDescription } from '../../lib/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { prev, next } = neighbours(project);
const hero = project.hero ? asset(project.hero) : undefined;
// The tilted screenshots are 440px wide in the mockups, the widest one 460px.
const tiltWidth = hero && hero.width / hero.height > 2.05 ? 460 : 440;
const description = metaDescription(project.description);
const isGitHub = (url: string): boolean => new URL(url).hostname === 'github.com';
const badge = `${project.kind} ${project.position} of ${projects.length}`;
const track = (url: string) => (isGitHub(url) ? { 'data-event': 'github_click', 'data-slug': project.slug, 'data-placement': 'project' } : {});
---

<Base title={`${project.title} | ${person.name}`} description={description}>
  <div class="page project staged">
    <Sky />
    <Orbits class="orbits-backdrop" />

    <div class="stage-wrap">
      <div class="stage">
        <SiteHeader slim>
          <nav class="pager only-desktop" aria-label="Projects">
            <a class="pager-link pager-prev" href={projectUrl(prev.slug)} rel="prev" data-pager="prev">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 6l-6 6 6 6"></path></svg>
              <span class="sr-only">Previous project: </span><span class="pager-name">{prev.name}</span>
            </a>
            <p class="label-pill"><span aria-hidden="true">{project.position}</span>{badge}</p>
            <a class="pager-link pager-next" href={projectUrl(next.slug)} rel="next" data-pager="next">
              <span class="sr-only">Next project: </span><span class="pager-name">{next.name}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 6l6 6-6 6"></path></svg>
            </a>
          </nav>
        </SiteHeader>

        <div class="project-body">
          <div class="hero float">
            <div class="hero-stage">
              <img class="ring-frame spin" src={frame.src} alt="" width="320" height="320" fetchpriority="high" />
              {project.heroKind === 'image' && hero && <Pic class="hero-flat" src={hero} width={468} widths={[480, 720, 960]} sizes="(min-width: 1200px) 468px, (min-width: 640px) 378px, 80vw" alt={project.heroAlt} loading="eager" fetchpriority="high" />}
              {project.heroKind === 'cube' && <CubeCanvas class="hero-cube" alt={project.heroAlt} eager />}
              {
                project.heroKind === 'lens' && (
                  <div class="hero-lens" role="img" aria-label={project.heroAlt}>
                    <LensCard hero />
                  </div>
                )
              }
              {
                project.heroKind === 'tilted' && hero && (
                  <div class="hero-tilt" style={`width: ${tiltWidth}px; aspect-ratio: ${hero.width} / ${hero.height}`}>
                    <Pic src={hero} width={tiltWidth} widths={[460, 720, 920, 1100]} sizes="(min-width: 1200px) 460px, (min-width: 640px) 372px, 80vw" alt={project.heroAlt} loading="eager" fetchpriority="high" />
                  </div>
                )
              }
              {
                project.heroKind === 'pipeline' && (
                  <div class="hero-pipeline">
                    <PipelineArt width={330} label={project.heroAlt} />
                  </div>
                )
              }
            </div>
            <script is:inline>
              // The hero is drawn at 520px and scaled to its box. The scale is measured here and not
              // worked out in CSS: tan(atan2(100cqw, 520px)) comes out wrong in Safari 18 (0.14 on a
              // 430px-wide iPhone, where it should be 0.69), which left the hero tiny in a corner.
              (() => {
                const hero = document.currentScript.parentElement;
                const fit = () => hero.style.setProperty('--hero-s', (hero.clientWidth / 520).toFixed(4));
                fit();
                if ('ResizeObserver' in window) new ResizeObserver(fit).observe(hero);
                else addEventListener('resize', fit);
              })();
            </script>
          </div>

          <main class="project-main">
            <p class="label-pill label-small only-mobile"><span aria-hidden="true">{project.position}</span>{badge}</p>
            <div class={`title-row ${project.title.length > 20 ? 'title-long' : ''}`}>
              <h1>{project.title}</h1>
              {project.chips.map((chip) => <span class="chip chip-lg">{chip}</span>)}
            </div>
            <div class="gold-rule" aria-hidden="true"></div>
            <p class="lede">{highlight(project.description, project.highlights).map((part) => (part.mark ? <span class="gold">{part.text}</span> : part.text))}</p>
            {project.awardsLine && <p class="awards">{project.awardsLine}</p>}

            <dl class="facts">
              {
                project.facts.map(([label, value]) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))
              }
            </dl>

            <div class="actions">
              <a class="primary" href={project.primary[1]} target="_blank" rel="noopener noreferrer" {...track(project.primary[1])}>{project.primary[0]}<NewTab /></a>
              {
                project.links.map(([label, url]) => (
                  <a class="text-link" href={url} target="_blank" rel="noopener noreferrer" {...track(url)}>
                    {label}
                    <NewTab />
                  </a>
                ))
              }
            </div>

            <section class="problem">
              <h2>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"></path>
                </svg>
                {project.problemLabel}
              </h2>
              <p>{project.problem}</p>
            </section>

            <div class="shots">
              {
                project.shots.map((shot) => (
                  <figure>
                    <Pic class={shot.pixelated ? 'px' : undefined} src={asset(shot.src)} width={294} widths={[320, 640, 900]} sizes="(min-width: 640px) 294px, 46vw" alt={shot.alt} crisp={shot.pixelated} />
                    <figcaption>{shot.caption}</figcaption>
                  </figure>
                ))
              }
            </div>
            <p class="stack">{project.stack.join(' · ')}</p>
          </main>
        </div>

        <!-- phones and tablets: previous and next sit at the end of the page -->
        <nav class="pager-foot only-mobile" aria-label="Projects">
          <a class="pager-btn" href={projectUrl(prev.slug)} rel="prev" data-pager="prev">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 6l-6 6 6 6"></path></svg>
            <span>
              <span class="pager-kicker">Previous<span class="sr-only"> project:</span></span>
              <span class="pager-btn-name">{prev.name}</span>
            </span>
          </a>
          <a class="pager-btn pager-btn-next" href={projectUrl(next.slug)} rel="next" data-pager="next">
            <span>
              <span class="pager-kicker">Next<span class="sr-only"> project:</span></span>
              <span class="pager-btn-name">{next.name}</span>
            </span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 6l6 6-6 6"></path></svg>
          </a>
        </nav>

      </div>
    </div>
  </div>
</Base>

<script>
  // Left and Right arrow keys go to the previous and next project.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || event.defaultPrevented) return;
    const target = event.target as HTMLElement | null;
    // not while typing, and not while the contact panel is open
    if (target?.closest('input, textarea, select, [contenteditable]') || document.querySelector('dialog[open]')) return;
    const link = document.querySelector<HTMLAnchorElement>(`[data-pager="${event.key === 'ArrowLeft' ? 'prev' : 'next'}"]`);
    if (!link) return;
    event.preventDefault();
    link.click();
  });
</script>

<style is:global>
  .project {
    --sky-position: 30% center;
  }

  /* ---- "3 of 7", and previous and next ----
     Wide screens: all three in the header. Below 1200px: the badge sits small above the
     title and previous and next are two buttons at the end of the page. */

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    flex: 0 1 auto;
    gap: 0 14px;
    min-width: 0;
    margin: 6px auto 0;
    font-size: 15px;
  }

  .label-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 7px 16px 7px 8px;
    border-radius: 24px;
    background: rgb(var(--sky-rgb) / 0.5);
    border: 1px solid rgb(var(--gold-rgb) / 0.35);
    white-space: nowrap;
  }

  .label-pill span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--gold);
    font-size: 12px;
  }

  .label-small {
    align-self: flex-start;
    gap: 8px;
    margin-bottom: -6px;
    padding: 4px 12px 4px 5px;
    font-size: 13px;
  }

  .label-small span {
    width: 20px;
    height: 20px;
    font-size: 11px;
  }

  .pager-link {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    min-height: 44px;
  }

  .pager-prev {
    justify-self: start;
  }

  .pager-next {
    justify-self: end;
  }

  .pager-link svg,
  .pager-btn svg {
    flex: none;
    color: var(--gold);
  }

  .pager-name {
    max-width: 150px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pager-foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    box-sizing: border-box;
    width: 100%;
    max-width: 640px;
    margin: 32px auto 0;
    padding: 0 20px 44px;
  }

  .pager-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    box-sizing: border-box;
    min-width: 0;
    min-height: 64px;
    padding: 10px 14px;
    border: 1px solid rgb(var(--gold-rgb) / 0.4);
    border-radius: 16px;
    background: rgb(var(--sky-rgb) / 0.45);
  }

  .pager-btn-next {
    justify-content: flex-end;
    text-align: right;
  }

  .pager-btn > span {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .pager-kicker {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .pager-btn-name {
    font-size: 16px;
    line-height: 1.25;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    box-sizing: border-box;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 16px 20px 0;
  }

  /* The hero is drawn at the mockup's 520px and scaled to whatever room it has. The script
     inside .hero measures the scale; the numbers here are what it comes to without JavaScript. */
  .hero {
    position: relative;
    flex: none;
    width: min(100%, 360px);
    aspect-ratio: 1;
    --hero-s: 0.6731;
    --float-rise: -10px;
  }

  .hero-stage {
    position: absolute;
    left: 0;
    top: 0;
    width: 520px;
    height: 520px;
    transform-origin: 0 0;
    transform: scale(var(--hero-s));
  }

  .hero-flat {
    position: absolute;
    left: 26px;
    top: 128px;
    width: 468px;
    height: auto;
  }

  .hero-cube {
    left: 71px;
    top: 66px;
    width: 378px;
    height: 378px;
  }

  .hero-lens {
    position: absolute;
    inset: 0;
  }

  .hero-lens .lens-card {
    transform: scale(2.35);
  }

  .hero-lens .lens-shot {
    border-radius: 4px;
    box-shadow: 0 8px 18px rgb(0 0 0 / 0.5);
  }

  .hero-tilt {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    perspective: 1200px;
  }

  .hero-tilt img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    object-fit: cover;
    box-shadow:
      0 0 0 1px rgb(var(--gold-rgb) / 0.5),
      0 24px 50px rgb(0 0 0 / 0.6);
    transform: rotateX(8deg) rotateY(-16deg) rotateZ(2deg);
  }

  .hero-pipeline {
    position: absolute;
    left: 95px;
    top: 160px;
  }

  .project-main {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    max-width: 600px;
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .title-row h1 {
    margin: 0;
    font-size: clamp(34px, 9vw, 46px);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .title-long h1 {
    font-size: clamp(28px, 7.4vw, 36px);
  }

  .chip-lg {
    padding: 5px 12px;
    border-radius: 14px;
    font-size: 12px;
  }

  .lede {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--body);
  }

  .awards {
    margin: -6px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--gold);
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 12px;
    margin: 0;
    border-top: 1px solid rgb(var(--gold-rgb) / 0.25);
    border-bottom: 1px solid rgb(var(--gold-rgb) / 0.25);
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
  }

  /* on a phone the role gets a row to itself, so a long one does not squeeze the others */
  .facts div:first-child {
    grid-column: 1 / -1;
    padding-bottom: 0;
  }

  .facts dt {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0;
    font-size: 16px;
  }

  /* The buttons sit under the role and facts, so they are on the first screen with the title. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 22px;
    font-size: 16px;
  }

  .text-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: rgb(var(--gold-rgb) / 0.5);
    text-underline-offset: 5px;
  }

  .primary {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 28px;
    background: var(--text);
    color: var(--ink);
    font-size: 19px;
    font-weight: 500;
  }

  .primary:hover {
    background: var(--gold);
    color: var(--ink);
  }

  .problem {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .problem h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 15px;
    font-weight: 400;
    color: var(--gold);
  }

  .problem p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--body);
  }

  .shots {
    display: flex;
    gap: 12px;
  }

  .shots figure {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    margin: 0;
  }

  .shots img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    aspect-ratio: 294 / 150;
    object-fit: cover;
    object-position: center top;
    border: 1px solid rgb(var(--gold-rgb) / 0.45);
    background: #fff;
  }

  .shots img.px {
    object-position: center;
    background: none;
  }

  .shots figcaption {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .stack {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.06em;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (min-width: 640px) {
    .project-body {
      padding: 24px 40px 0;
    }

    .hero {
      width: min(100%, 420px);
      --hero-s: 0.8077;
    }

    .facts {
      grid-template-columns: minmax(33%, max-content) 1fr 1fr;
    }

    .facts div:first-child {
      grid-column: auto;
      padding-bottom: 12px;
    }

    .primary {
      width: auto;
      min-width: 300px;
    }

    .pager-foot {
      max-width: 680px;
      padding: 0 40px 56px;
    }
  }

  /* ===== wide screens: hero left, text right, on the 1440 x 900 stage (design/Detail*.html) =====
     Everything fits the stage at design size: the tallest column (Unify) ends at 863px. */

  @media (min-width: 1200px) {
    .project-body {
      display: grid;
      grid-template-columns: 1fr 600px;
      align-items: start;
      gap: 0 90px;
      max-width: none;
      padding: 27px 80px 0 64px;
    }

    .hero {
      justify-self: end;
      width: 520px;
      margin: 50px 0 0;
      --hero-s: 1;
    }
  }
</style>
