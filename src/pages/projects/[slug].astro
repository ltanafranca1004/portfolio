---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CubeCanvas from '../../components/CubeCanvas.astro';
import LensCard from '../../components/LensCard.astro';
import Orbits from '../../components/Orbits.astro';
import PipelineArt from '../../components/PipelineArt.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Sky from '../../components/Sky.astro';
import frame from '../../assets/frame.svg';
import { asset, person } from '../../lib/content';
import { highlight, projects, type Project } from '../../lib/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const hero = project.hero ? asset(project.hero) : undefined;
// The tilted screenshots are 440px wide in the mockups, the widest one 460px.
const tiltWidth = hero && hero.width / hero.height > 2.05 ? 460 : 440;
const description = project.description.length > 158 ? `${project.description.slice(0, 155).replace(/\s+\S*$/, '')}...` : project.description;
---

<Base title={`${project.title} | ${person.name}`} description={description}>
  <div class="page project">
    <Sky />
    <Orbits class="orbits-backdrop" />

    <SiteHeader>
      <p class="label-pill"><span aria-hidden="true">{project.badge}</span>{project.label}</p>
    </SiteHeader>

    <div class="project-body">
      <div class="hero float">
        <div class="hero-stage">
          <img class="ring-frame spin" src={frame.src} alt="" width="320" height="320" />
          {
            project.heroKind === 'image' && hero && (
              <Picture class="hero-flat" src={hero} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 960]} sizes="(min-width: 1000px) 468px, 80vw" alt={project.heroAlt} loading="eager" />
            )
          }
          {project.heroKind === 'cube' && <CubeCanvas class="hero-cube" alt={project.heroAlt} />}
          {
            project.heroKind === 'lens' && (
              <div class="hero-lens" role="img" aria-label={project.heroAlt}>
                <LensCard />
              </div>
            )
          }
          {
            project.heroKind === 'tilted' && hero && (
              <div class="hero-tilt" style={`width: ${tiltWidth}px; aspect-ratio: ${hero.width} / ${hero.height}`}>
                <Picture src={hero} formats={['avif', 'webp']} fallbackFormat="webp" widths={[460, 920]} sizes="(min-width: 1000px) 460px, 80vw" alt={project.heroAlt} loading="eager" />
              </div>
            )
          }
          {
            project.heroKind === 'pipeline' && (
              <div class="hero-pipeline">
                <PipelineArt width={330} label={project.heroAlt} />
              </div>
            )
          }
        </div>
      </div>

      <main class="project-main">
        <div class={`title-row ${project.title.length > 20 ? 'title-long' : ''}`}>
          <h1>{project.title}</h1>
          {project.chips.map((chip) => <span class="chip chip-lg">{chip}</span>)}
        </div>
        <div class="gold-rule" aria-hidden="true"></div>
        <p class="lede">{highlight(project.description, project.highlights).map((part) => (part.mark ? <span class="gold">{part.text}</span> : part.text))}</p>
        {project.awardsLine && <p class="awards">{project.awardsLine}</p>}

        <dl class="facts">
          {
            project.facts.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>

        <section class="problem">
          <h2>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" />
            </svg>
            {project.problemLabel}
          </h2>
          <p>{project.problem}</p>
        </section>

        <div class="shots">
          {
            project.shots.map((shot) => (
              <figure>
                <Picture
                  class={shot.pixelated ? 'px' : undefined}
                  src={asset(shot.src)}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={[320, 640]}
                  sizes="(min-width: 1000px) 294px, 46vw"
                  quality={shot.pixelated ? 82 : undefined}
                  alt={shot.alt}
                  loading="lazy"
                />
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))
          }
        </div>
        <p class="stack">{project.stack.join(' · ')}</p>
      </main>
    </div>

    <footer class="project-foot">
      <a class="back" href="/">
        <span class="back-btn" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 6l-6 6 6 6M4 12h16"></path></svg>
        </span>
        <span class="back-text">
          <span class="back-note">{project.footnote}</span>
          <span class="back-label">Back to the map</span>
        </span>
      </a>
      <div class="actions">
        {project.links.map(([label, url]) => <a class="text-link" href={url} rel="noopener" data-track="project-link">{label}</a>)}
        <a class="primary" href={project.primary[1]} rel="noopener" data-track="project-primary" data-world={project.slug}>{project.primary[0]}</a>
      </div>
    </footer>
  </div>
</Base>

<style is:global>
  .project {
    display: flex;
    flex-direction: column;
    --sky-position: 30% center;
  }

  /* The pill sits between the name and the nav on wide screens, under the header on phones. */
  .label-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 6px 17px 0 auto;
    padding: 7px 16px 7px 8px;
    border-radius: 24px;
    background: rgb(var(--sky-rgb) / 0.5);
    border: 1px solid rgb(var(--gold-rgb) / 0.35);
    font-size: 15px;
    white-space: nowrap;
  }

  .label-pill span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--gold);
    font-size: 12px;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    box-sizing: border-box;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 28px 20px 0;
  }

  /* The hero is drawn at the mockup's 520px and scaled to whatever room it has. */
  .hero {
    position: relative;
    flex: none;
    width: min(100%, 360px);
    aspect-ratio: 1;
    container-type: inline-size;
    --float-rise: -10px;
  }

  .hero-stage {
    position: absolute;
    left: 0;
    top: 0;
    width: 520px;
    height: 520px;
    transform-origin: 0 0;
    transform: scale(tan(atan2(100cqw, 520px)));
  }

  .hero-flat {
    position: absolute;
    left: 26px;
    top: 128px;
    width: 468px;
    height: auto;
  }

  .hero-cube {
    left: 71px;
    top: 66px;
    width: 378px;
    height: 378px;
  }

  .hero-lens {
    position: absolute;
    inset: 0;
  }

  .hero-lens .lens-card {
    transform: scale(2.35);
  }

  .hero-lens .lens-shot {
    border-radius: 4px;
    box-shadow: 0 8px 18px rgb(0 0 0 / 0.5);
  }

  .hero-tilt {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    perspective: 1200px;
  }

  .hero-tilt img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    object-fit: cover;
    box-shadow:
      0 0 0 1px rgb(var(--gold-rgb) / 0.5),
      0 24px 50px rgb(0 0 0 / 0.6);
    transform: rotateX(8deg) rotateY(-16deg) rotateZ(2deg);
  }

  .hero-pipeline {
    position: absolute;
    left: 95px;
    top: 160px;
  }

  .project-main {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    max-width: 600px;
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .title-row h1 {
    margin: 0;
    font-size: clamp(34px, 9vw, 46px);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .title-long h1 {
    font-size: clamp(28px, 7.4vw, 36px);
  }

  .chip-lg {
    padding: 5px 12px;
    border-radius: 14px;
    font-size: 12px;
  }

  .lede {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--body);
  }

  .awards {
    margin: -6px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--gold);
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 12px;
    margin: 0;
    border-top: 1px solid rgb(var(--gold-rgb) / 0.25);
    border-bottom: 1px solid rgb(var(--gold-rgb) / 0.25);
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
  }

  /* on a phone the role gets a row to itself, so a long one does not squeeze the others */
  .facts div:first-child {
    grid-column: 1 / -1;
    padding-bottom: 0;
  }

  .facts dt {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0;
    font-size: 16px;
  }

  .problem {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .problem h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 15px;
    font-weight: 400;
    color: var(--gold);
  }

  .problem p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--body);
  }

  .shots {
    display: flex;
    gap: 12px;
  }

  .shots figure {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    margin: 0;
  }

  .shots img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    aspect-ratio: 294 / 150;
    object-fit: cover;
    object-position: center top;
    border: 1px solid rgb(var(--gold-rgb) / 0.45);
    background: #fff;
  }

  .shots img.px {
    object-position: center;
    background: none;
  }

  .shots figcaption {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .stack {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.06em;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .project-foot {
    display: flex;
    flex-direction: column-reverse;
    gap: 22px;
    box-sizing: border-box;
    width: 100%;
    max-width: 640px;
    margin: 32px auto 0;
    padding: 0 20px 36px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 20px;
    font-size: 16px;
  }

  .text-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: rgb(var(--gold-rgb) / 0.5);
    text-underline-offset: 5px;
  }

  .primary {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    order: -1;
    width: 100%;
    min-height: 56px;
    border-radius: 28px;
    background: var(--text);
    color: var(--ink);
    font-size: 19px;
    font-weight: 500;
  }

  .primary:hover {
    background: var(--gold);
    color: var(--ink);
  }

  @media (max-width: 999px) {
    .project .site-header {
      flex-wrap: wrap;
    }

    .project .site-header::after {
      content: '';
      order: 2;
      flex-basis: 100%;
    }

    .label-pill {
      order: 3;
      margin: 18px auto 0;
    }
  }

  @media (min-width: 640px) {
    .project-body {
      padding: 36px 40px 0;
    }

    .facts {
      grid-template-columns: minmax(33%, max-content) 1fr 1fr;
    }

    .facts div:first-child {
      grid-column: auto;
      padding-bottom: 12px;
    }

    .hero {
      width: min(100%, 420px);
    }

    .project-foot {
      padding: 0 40px 44px;
    }
  }

  /* ===== wide screens: hero left, text right (design/Detail*.html) ===== */

  @media (min-width: 1000px) {
    .project-body {
      display: grid;
      grid-template-columns: minmax(280px, 1fr) minmax(0, 600px);
      align-items: start;
      gap: 0 clamp(32px, 6.25vw, 90px);
      padding: 27px 80px 0 64px;
    }

    .hero {
      justify-self: end;
      width: min(100%, 520px);
      margin: 50px 0 0;
    }

    .project-foot {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      max-width: 1440px;
      margin-top: auto;
      padding: 16px 64px 44px;
    }

    .back {
      align-self: center;
    }

    .actions {
      flex-wrap: nowrap;
      justify-content: flex-end;
    }

    .primary {
      order: 0;
      width: auto;
      min-width: 300px;
    }
  }
</style>
