---
import { getImage } from 'astro:assets';
import { asset } from '../lib/content';

// The real Lens screenshot with a gold loupe gliding over it. Decorative: the caller labels it.
const shot = asset('assets/lens-real.webp');
const small = await getImage({ src: shot, width: 380, format: 'webp' });
const large = await getImage({ src: shot, width: 684, format: 'webp' });
---

<div class="lens-card" aria-hidden="true">
  <div class="lens-tilt">
    <img class="lens-shot" src={small.src} alt="" width="190" height="85" decoding="async" />
    <div class="loupe"><img class="loupe-img" src={large.src} alt="" width="342" height="153" decoding="async" /></div>
  </div>
</div>
