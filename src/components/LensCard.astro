---
import { getImage } from 'astro:assets';
import hd from '../assets/lens-hd.webp';

// The real Lens screenshot with a gold loupe gliding over it. Decorative: the caller labels it.
//
// Both layers come from src/assets/lens-hd.webp (1340px wide), the full-size capture that
// redesign/assets/lens-real.webp was shrunk from. The loupe shows the card at 1.8x, so it
// gets its own files at three times the card's CSS size or more, not an enlarged copy.
interface Props {
  /** The big card on the Lens page: drawn 2.35x larger, and on the first screen everywhere. */
  hero?: boolean;
}

const { hero = false } = Astro.props;
const loading = hero ? 'eager' : 'lazy';
const file = (width: number) => getImage({ src: hd, width, format: 'webp', quality: 88 });
const set = async (widths: number[], unit: (w: number, i: number) => string) => (await Promise.all(widths.map(file))).map((img, i) => `${img.src} ${unit(widths[i]!, i)}`).join(', ');

// On the map the card is 190 CSS px wide (238 when the map is scaled up) and the loupe layer
// 342: fixed sizes, so plain 1x/2x/3x files, and one loupe file at three times its CSS size.
// On the Lens page both are 2.35x larger and shrink with the hero on small screens, so the
// browser picks by width: 446 and 804 CSS px on wide screens, about 310 and 560 on a phone.
const fallback = await file(hero ? 892 : 238);
const cardSet = hero ? await set([640, 892, 1340], (w) => `${w}w`) : await set([238, 476, 714], (_, i) => `${i + 1}x`);
const cardSizes = hero ? '(min-width: 1000px) 446px, 310px' : undefined;
const loupe = await file(hero ? 1340 : 1026);
const loupeSet = hero ? await set([1026, 1340], (w) => `${w}w`) : undefined;
const loupeSizes = hero ? '(min-width: 1000px) 804px, 560px' : undefined;
---

<div class="lens-card" aria-hidden="true">
  <div class="lens-tilt">
    <img class="lens-shot" src={fallback.src} srcset={cardSet} sizes={cardSizes} alt="" width="190" height="85" loading={loading} decoding="async" fetchpriority={hero ? 'high' : undefined} />
    <div class="loupe"><img class="loupe-img" src={loupe.src} srcset={loupeSet} sizes={loupeSizes} alt="" width="342" height="153" loading={loading} decoding="async" /></div>
  </div>
</div>
