---
import { getImage } from 'astro:assets';
import skySource from '../../redesign/assets/sky-source-2880.jpg';
import skyPhone from '../assets/sky-phone.jpg';

// The star field. Phones get a narrow crop of the same sky; wide screens pick a width.
const WIDTHS = [1280, 1920, 2880];
const wide = async (format: 'avif' | 'webp') =>
  (await Promise.all(WIDTHS.map((width) => getImage({ src: skySource, width, format, quality: format === 'avif' ? 50 : 68 }))))
    .map((img, i) => `${img.src} ${WIDTHS[i]}w`)
    .join(', ');
const phone = async (format: 'avif' | 'webp') =>
  (await getImage({ src: skyPhone, width: 880, format, quality: format === 'avif' ? 48 : 64 })).src;

const [wideAvif, wideWebp, phoneAvif, phoneWebp] = await Promise.all([wide('avif'), wide('webp'), phone('avif'), phone('webp')]);
const fallback = await getImage({ src: skySource, width: 1920, format: 'webp', quality: 68 });
// Below the desktop layout the sky is stretched over a tall page, so it needs the big file.
const sizes = '(max-width: 1199px) 3200px, 100vw';
---

<picture class="sky">
  <source media="(max-width: 600px)" type="image/avif" srcset={phoneAvif} />
  <source media="(max-width: 600px)" type="image/webp" srcset={phoneWebp} />
  <source type="image/avif" srcset={wideAvif} sizes={sizes} />
  <source type="image/webp" srcset={wideWebp} sizes={sizes} />
  <!-- fetched first and drawn with the first frame: a page without its sky is a flash of flat colour -->
  <img src={fallback.src} alt="" width="1920" height="1200" decoding="sync" fetchpriority="high" />
</picture>
