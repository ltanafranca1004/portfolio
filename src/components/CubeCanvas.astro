---
import atlas from '../assets/cube-faces.png';
import still from '../assets/cube-still.png';

interface Props {
  alt?: string;
  class?: string;
  /** Load the still frame straight away: for a cube that is on the first screen everywhere. */
  eager?: boolean;
}

const { alt = '', class: className = '', eager = false } = Astro.props;
---

<span class={`cube ${className}`}>
  <img class="cube-still px" src={still.src} alt={alt} width="252" height="252" loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'} />
  <canvas class="cube-live px" width="252" height="252" data-cube data-atlas={atlas.src} aria-hidden="true"></canvas>
</span>

<script>
  import '../scripts/cube/mount';
</script>
