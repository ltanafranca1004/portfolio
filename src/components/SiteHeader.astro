---
import NewTab from './NewTab.astro';
import { person, RESUME_URL } from '../lib/content';

interface Props {
  /** On the map the name is the page heading; elsewhere the whole block is the way back to the map. */
  home?: boolean;
  /** Project pages: below 1200px the header is only the back control and Contact. */
  slim?: boolean;
}

const { home = false, slim = false } = Astro.props;
---

<header class={`site-header ${slim ? 'site-header-slim' : ''}`}>
  {
    home ? (
      <div class="brand">
        <svg class="brand-pin" viewBox="0 0 30 38" fill="none" aria-hidden="true">
          <path d="M15 36c-6-9-12-15-12-22a12 12 0 0 1 24 0c0 7-6 13-12 22z" />
          <circle cx="15" cy="14" r="5" />
        </svg>
        <div>
          <span class="brand-kicker">Navigation</span>
          <h1 class="brand-name">{person.name}</h1>
        </div>
      </div>
    ) : (
      <a class="brand brand-back" href="/" data-back>
        <span class="brand-arrow" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 6l-6 6 6 6M4 12h16"></path></svg>
        </span>
        <span>
          <span class="brand-kicker">Back to map</span>
          <span class="brand-name">{person.name}</span>
        </span>
      </a>
    )
  }
  <slot />
  <nav class="site-nav" aria-label="Main">
    <a class="icon-btn header-extra" href={person.github} target="_blank" rel="me noopener noreferrer" data-event="github_click" data-placement="header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z" />
      </svg>
      <span class="sr-only">GitHub</span><NewTab icon={false} />
    </a>
    <a class="icon-btn header-extra" href={person.linkedin} target="_blank" rel="me noopener noreferrer" data-event="linkedin_click" data-placement="header">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4V21H3zM9.5 9.75h3.83v1.54h.05c.53-1.01 1.84-2.07 3.79-2.07 4.05 0 4.8 2.67 4.8 6.13V21h-4v-4.99c0-1.19-.02-2.72-1.66-2.72-1.66 0-1.91 1.3-1.91 2.63V21h-4z" />
      </svg>
      <span class="sr-only">LinkedIn</span><NewTab icon={false} />
    </a>
    <a class="pill pill-ghost header-extra" href={RESUME_URL} target="_blank" rel="noopener noreferrer" data-event="resume_open" data-placement="header">Resume<NewTab /></a>
    <a class="pill pill-solid" href={`mailto:${person.email}`} data-contact-open data-event="contact_open" data-placement="header">Contact</a>
  </nav>
</header>

<script>
  // The back control returns to the map where it was left.
  //
  // When the page before this one in the tab's history is the map, the control goes back to
  // it (history.back()) instead of loading "/" again: the browser then shows the map as it
  // was, at the same scroll position, from its back/forward cache when it can. Otherwise
  // (this page was opened directly, or reached from another project) it loads "/" as a link
  // and asks the map to restore the position it saved (pages/index.astro).
  //
  // "Is the page before this one the map?" is answered by the Navigation API where there is
  // one (Chrome, Edge, Safari 26.2 and later, Firefox 147 and later). Elsewhere a page that
  // was opened by a link on the map marks its own history entry when it loads.
  interface NavigationEntryLike {
    url: string | null;
    index: number;
  }
  interface NavigationLike {
    currentEntry: NavigationEntryLike | null;
    entries(): NavigationEntryLike[];
  }
  const navigation = (window as { navigation?: NavigationLike }).navigation;
  const isMap = (url: string | null): boolean => {
    if (!url) return false;
    const parsed = new URL(url, location.href);
    return parsed.origin === location.origin && parsed.pathname === '/';
  };

  try {
    const arrival = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    if (arrival?.type === 'navigate' && isMap(document.referrer) && !isMap(location.href)) history.replaceState({ ...history.state, fromMap: true }, '');
  } catch {
    /* the back control then loads the map afresh */
  }

  const mapIsBehind = (): boolean => {
    const entry = navigation?.currentEntry;
    if (navigation && entry) return entry.index > 0 && isMap(navigation.entries()[entry.index - 1]?.url ?? null);
    return history.length > 1 && (history.state as { fromMap?: boolean } | null)?.fromMap === true;
  };

  document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    if (mapIsBehind()) {
      event.preventDefault();
      history.back();
      return;
    }
    try {
      sessionStorage.setItem('map-return', '1');
    } catch {
      /* no storage: the map opens at its top */
    }
  });

  // Esc goes back to the map from any page with the back control. While the contact panel is
  // open Esc only closes the panel (the browser does that itself).
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    if (document.querySelector('dialog[open]')) return;
    // a click on the control itself, so Esc goes back exactly as it does
    document.querySelector<HTMLAnchorElement>('[data-back]')?.click();
  });
</script>
