---
import '../styles/global.css';
import ContactPanel from '../components/ContactPanel.astro';
import keepout from '../scripts/keepout.js?raw';
import transitions from '../scripts/transitions.js?raw';
import jostUrl from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import { person } from '../lib/content';
import { projects } from '../lib/projects';
import { absoluteUrl, IS_PRODUCTION, OG_IMAGE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Open Graph type: "website" for most pages, "profile" for the profile. */
  ogType?: 'website' | 'profile';
  /** Structured data for this page, as a JSON-LD object. */
  jsonLd?: Record<string, unknown>;
  /** Keep this page out of search results even on the production site. */
  noindex?: boolean;
}

const { title, description, ogType = 'website', jsonLd, noindex = false } = Astro.props;
const canonical = absoluteUrl(Astro.url.pathname);
const image = absoluteUrl(OG_IMAGE.path);
const imageAlt = `${person.name}, ${person.title}: a gold route map over a navy star field`;
---

<!doctype html>
<html lang="en" data-projects={projects.map((p) => p.slug).join(',')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Inline, before anything else can run or load:
      - the page colour, so no frame is ever painted white or black while a stylesheet loads
        or one page hands over to the next;
      - the opt-in to page transitions. In the stylesheet it sometimes arrived after the
        browser had already decided this page had not opted in, and the transition was dropped.

      Safari gets no page transitions: Chrome and Edge cross-fade, Safari on macOS and every
      browser on iOS (they are all Safari's engine, Chrome for iPhone included) navigate
      plainly and at once. Safari is told apart by a feature, not by its name: only Apple's
      WebKit understands the system font keyword in "font: -apple-system-body", so the opt-in
      sits inside "@supports not (...)" and Safari never sees it. Checked in Playwright's
      WebKit (true) and in Chromium and Firefox (false); scripts/check-transitions.mjs fails
      if WebKit ever runs a transition or Chromium stops. The prefetch (scripts/prefetch.ts)
      is separate and stays on.
    -->
    <style is:inline>
      html,
      body {
        background: #050815;
      }
      @media (prefers-reduced-motion: no-preference) {
        @supports not (font: -apple-system-body) {
          @view-transition {
            navigation: auto;
          }
        }
      }
    </style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !IS_PRODUCTION) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#050815" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" as="font" type="font/woff2" href={jostUrl} crossorigin />
    <slot name="head" />
    <script is:inline>
      // The stage and the orbit lines stay hidden until the page is settled: the text is in its
      // real font and the lines are masked around it (scripts/keepout.js, at the end of the
      // content, lifts this before the first paint whenever the font is already here). After
      // three seconds the page shows whatever state it is in.
      document.documentElement.classList.add('settling');
      setTimeout(() => document.documentElement.classList.remove('settling'), 3000);
      // The window size as plain numbers (--vw, --vh), so CSS can work out the stage scale with
      // ordinary division. The CSS-only way, tan(atan2(100vw, 1440px)), is wrong in Safari 18.
      // Only the wide layout uses them. Below it nothing is set, so a phone's toolbar hiding
      // and showing (a change of height on every scroll) costs no restyle.
      (() => {
        const root = document.documentElement;
        let last = '';
        const size = () => {
          const w = innerWidth;
          const next = w >= 1200 ? `${w}x${innerHeight}` : '';
          if (next === last) return;
          last = next;
          if (next) {
            root.style.setProperty('--vw', String(w));
            root.style.setProperty('--vh', String(innerHeight));
          } else {
            root.style.removeProperty('--vw');
            root.style.removeProperty('--vh');
          }
        };
        size();
        for (const type of ['resize', 'pageshow', 'DOMContentLoaded']) addEventListener(type, size);
        document.addEventListener('prerenderingchange', size);
      })();
    </script>
    <!--
      Chrome and Edge: when a link to another page of this site is hovered for a moment or
      pressed, that page is loaded and rendered in the background, so the click shows it at
      once. Other browsers get the page and its main picture fetched instead (scripts/prefetch.ts).
    -->
    <script type="speculationrules" is:inline set:html={JSON.stringify({ prerender: [{ where: { or: [{ href_matches: '/' }, { href_matches: '/profile/' }, { href_matches: '/projects/*' }] }, eagerness: 'moderate' }] })} />
    <!--
      Page transitions use the browser's own cross-document view transitions, not a
      client-side router: every navigation is a normal page load, and in Chrome and Edge the
      old page cross-fades into the new one over 200ms (see global.css). Safari and browsers
      without the feature just navigate.

      The page waits for #page-end, its last element, before its first paint. Measured in
      Session 7: that costs 0 to 16ms of first paint, and without it a slow connection paints
      the page in pieces (twice as many things appear or change after the first paint).
    -->
    <link rel="expect" href="#page-end" blocking="render" />
    <script is:inline set:html={transitions} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
    <script is:inline>
      // Pictures that are on the first screen only in the wide layout (the map's later worlds,
      // a project's screenshots): fetched at once there, with priority, and drawn in the same
      // frame they arrive in. On a phone they are far down the page and stay lazy.
      if (innerWidth >= 1200) {
        for (const img of document.querySelectorAll('img[data-eager-wide]')) {
          img.loading = 'eager';
          img.decoding = 'sync';
          img.fetchPriority = 'high';
        }
      }
    </script>
    <script is:inline set:html={keepout} />
    <span id="page-end" hidden></span>
    <ContactPanel />
    <script>
      import '../scripts/offscreen';
      import '../scripts/prefetch';
      import '../scripts/analytics';
    </script>
  </body>
</html>
