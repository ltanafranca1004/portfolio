---
import '../styles/global.css';
import ContactPanel from '../components/ContactPanel.astro';
import transitions from '../scripts/transitions.js?raw';
import jostUrl from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import { person } from '../lib/content';
import { projects } from '../lib/projects';
import { absoluteUrl, IS_PRODUCTION, OG_IMAGE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Open Graph type: "website" for most pages, "profile" for the profile. */
  ogType?: 'website' | 'profile';
  /** Structured data for this page, as a JSON-LD object. */
  jsonLd?: Record<string, unknown>;
  /** Keep this page out of search results even on the production site. */
  noindex?: boolean;
}

const { title, description, ogType = 'website', jsonLd, noindex = false } = Astro.props;
const canonical = absoluteUrl(Astro.url.pathname);
const image = absoluteUrl(OG_IMAGE.path);
const imageAlt = `${person.name}, ${person.title}: a gold route map over a navy star field`;
---

<!doctype html>
<html lang="en" data-projects={projects.map((p) => p.slug).join(',')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !IS_PRODUCTION) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#050815" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" as="font" type="font/woff2" href={jostUrl} crossorigin />
    <slot name="head" />
    <script is:inline>
      // lets CSS hide the orbit lines until the script that keeps them off text has run
      document.documentElement.classList.add('js');
      // The window size as plain numbers (--vw, --vh), so CSS can work out the stage scale with
      // ordinary division. The CSS-only way, tan(atan2(100vw, 1440px)), is wrong in Safari 18.
      (() => {
        const root = document.documentElement;
        const size = () => {
          root.style.setProperty('--vw', String(root.clientWidth || innerWidth));
          root.style.setProperty('--vh', String(innerHeight));
        };
        size();
        for (const type of ['resize', 'pageshow', 'DOMContentLoaded']) addEventListener(type, size);
      })();
    </script>
    <!--
      Page transitions use the browser's own cross-document view transitions (switched on in
      global.css), not a client-side router: every navigation is a normal page load.
        map to project      the clicked world grows into the hero ring; the sky zooms in
        project to map      the reverse
        project to project  a short sideways slide, in route order
      The script is inline and the page waits for #page-end before its first paint, because
      the browser asks which transition to run at that first paint: the listener and the
      elements it names must both exist by then. Browsers without the feature just navigate.
    -->
    <link rel="expect" href="#page-end" blocking="render" />
    <script is:inline set:html={transitions} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
    <span id="page-end" hidden></span>
    <ContactPanel />
    <script>
      import '../scripts/keepout';
      import '../scripts/analytics';
    </script>
  </body>
</html>
